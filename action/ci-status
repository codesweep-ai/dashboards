#!/usr/bin/env python3
"""Write ci-status.json: one repository's own CI health, for the dashboard to read.

Runs inside that repository's Actions job, so it reads only its own runs and the
job's built-in GITHUB_TOKEN is enough — nothing here reaches another repository.
"""

import base64
import json
import os
import re
import statistics
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
import urllib.error
import urllib.request
from datetime import datetime, timezone

SCHEMA = 2
API = "https://api.github.com"
# Where the versions a commit was published under are read: Go's module proxy,
# the container registry and npm's. None of them needs a token for a public
# project, and none of them is GitHub's rate-limited API.
GO_PROXY = "https://proxy.golang.org"
GHCR = "https://ghcr.io"
NPM = "https://registry.npmjs.org"

# The Pages build GitHub generates for any Pages site is not CI, and not this
# repository's to report. The runs API gives its display name and the workflows
# API its slug, so skip both spellings.
SKIP_WORKFLOWS = {"pages build and deployment", "pages-build-deployment"}

# The run doing the writing is itself in flight, and reporting it would put a
# workflow that never finishes on every card. Excluding the run rather than the
# workflow keeps that workflow's finished history, which is real news: whatever
# publishes the status can fail, and the failure should be visible.
SKIP_RUN_ID = os.environ.get("GITHUB_RUN_ID")
# Cancelled and skipped runs say nothing about the code, so they stay out of the
# denominator rather than being scored as failures.
PASSED = {"success"}
FAILED = {"failure", "timed_out", "startup_failure"}

# The workflow whose passing build a sibling may pin: the primary gate, which the
# dashboard puts first.
GATE = "ci"

# The workflow that publishes a project's images, where it has one. Something
# that pins a commit may install its image, so a commit is not built until its
# images are there. The registry says so: the run cannot, since GitHub lists a
# run that ci's finishing started under whatever commit was main's head by then.
IMAGES = "publish images"

# How many built commits the file names. A sibling pins the newest, and a repin
# that pushed a commit waits for it to appear here.
BUILT_KEEP = 10

# How many passing gate runs are looked at for them. A commit older than the
# branch's newest 100 costs a compare call to place, and the job's token has
# 1,000 requests an hour, spent several times a push.
BUILT_SCAN = 30


def api(path, token):
    req = urllib.request.Request(
        f"{API}/{path}",
        headers={
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "Authorization": f"Bearer {token}",
            "User-Agent": "ci-status",
        },
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)


def built(runs, on_branch, imaged=None, keep=BUILT_KEEP, scan=BUILT_SCAN):
    """The full SHAs of the newest push builds of the gate that passed, newest
    first, at most `keep` of them, from the newest `scan` such runs.

    `runs` are the gate's runs, newest first, as the API lists them. A commit
    built more than once is named once. `on_branch(sha)` says whether the commit
    is still on the branch, which a force-push can undo: a sibling that pins this
    commit should find it there. A commit that changed nothing CI builds has no
    run, so it is never named, and neither is one whose build failed or is still
    going.

    With `imaged`, the commit also needs `imaged(sha)` to say its images are
    out: the registry holds its version. One whose images failed, are still
    being pushed, or have been pruned since is passed over.
    """
    shas, seen = [], set()
    for r in runs:
        sha = r.get("head_sha") or ""
        if not (r.get("name") == GATE and r.get("event") == "push"
                and r.get("conclusion") in PASSED and sha) or sha in seen:
            continue
        seen.add(sha)
        if len(seen) > scan:
            break
        # The registry first: it costs no call to GitHub, and a compare can.
        if (imaged is None or imaged(sha)) and on_branch(sha):
            shas.append(sha)
            if len(shas) >= keep:
                break
    return shas


def built_entry(sha, versions):
    """A built commit as the file records it, with the versions it was published
    under."""
    return {"commit": sha, "versions": versions(sha)}


def fetch(url, headers=None):
    req = urllib.request.Request(url, headers={"User-Agent": "ci-status", **(headers or {})})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)


def quietly(read, default):
    """What read() answers, or default where the answer is not there to have.

    A version this file cannot learn is left out rather than failing the file,
    which the dashboard needs whether or not a registry answers."""
    try:
        return read()
    except urllib.error.HTTPError as exc:
        exc.close()   # it holds the response, and a refusal is all it says
        return default
    except (urllib.error.URLError, OSError, ValueError, KeyError, TypeError):
        return default


def own_run(owner, name):
    """Whether this runs in a job of owner/name itself, whose checkout and event
    can answer what would otherwise cost an API call."""
    return os.environ.get("GITHUB_ACTIONS") == "true" and os.environ.get("GITHUB_REPOSITORY") == f"{owner}/{name}"


def module_path(owner, name, ref, token):
    """The Go module the repository's go.mod declares at ref, or None. In the
    repository's own job, the checkout's go.mod answers."""
    def parse(text):
        for line in text.splitlines():
            f = line.split()
            if len(f) >= 2 and f[0] == "module":
                return f[1].strip('"')
        return None
    local = os.path.join(os.environ.get("GITHUB_WORKSPACE", "."), "go.mod")

    def read_local():
        with open(local, encoding="utf-8") as fh:
            return parse(fh.read())
    if own_run(owner, name):
        return quietly(read_local, None) if os.path.isfile(local) else None

    def read():
        doc = api(f"repos/{owner}/{name}/contents/go.mod?ref={ref}", token)
        return parse(base64.b64decode(doc["content"]).decode())
    return quietly(read, None)


def workspace():
    return os.environ.get("GITHUB_WORKSPACE", ".")


def declared_workflows(owner, name, token):
    """The repository's active workflows, by name, each with its path. In its own
    job the checkout's .github/workflows answers, a file named by its top-level
    `name:` or, as GitHub names one without it, its path. GitHub's flag for a
    workflow switched off by hand is not in the tree, so such a one is listed
    too."""
    if own_run(owner, name):
        found = {}
        top = os.path.join(workspace(), ".github", "workflows")
        for f in sorted(os.listdir(top)) if os.path.isdir(top) else []:
            if not f.endswith((".yml", ".yaml")):
                continue
            path = f".github/workflows/{f}"
            wf = path
            with open(os.path.join(top, f)) as fh:
                for line in fh:
                    m = re.match(r"^name:\s*(.*?)\s*$", line)
                    if m:
                        value = m.group(1)
                        if value[:1] in "\"'":
                            value = value[1:value.find(value[0], 1)]
                        else:
                            value = value.split(" #")[0].strip()
                        wf = value or path
                        break
            found[wf] = {"name": wf, "path": path, "state": "active"}
        return {n: w for n, w in found.items() if n not in SKIP_WORKFLOWS}
    return {
        w["name"]: w
        for w in api(f"repos/{owner}/{name}/actions/workflows", token).get("workflows", [])
        if w.get("state") == "active" and w["name"] not in SKIP_WORKFLOWS
    }


def local_history():
    """Whether the checkout holds the branch's history, so git can say which
    commits are on it."""
    try:
        out = subprocess.run(["git", "-C", workspace(), "rev-parse", "--is-shallow-repository"],
                             capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return False
    return out == "false"


def repo_meta(owner, name, token):
    """The repository's default branch, description, URL and last push. In its
    own job, the event that started the run carries them."""
    if own_run(owner, name):
        try:
            with open(os.environ["GITHUB_EVENT_PATH"]) as fh:
                repo = json.load(fh).get("repository") or {}
            if repo.get("default_branch"):
                pushed = repo.get("pushed_at")
                if isinstance(pushed, (int, float)):
                    # A push event gives it in epoch seconds.
                    repo["pushed_at"] = datetime.fromtimestamp(pushed, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                return repo
        except (KeyError, OSError, ValueError):
            pass
    return api(f"repos/{owner}/{name}", token)


def go_version(module, sha):
    """The version Go gives commit sha of module, as the module proxy computes it.

    It is what `go get` writes into go.mod for the commit, and what a binary built
    from a checkout of it reports, so it is the name everything else is published
    under too. None where the proxy cannot say."""
    if not module:
        return None
    escaped = "".join("!" + c.lower() if c.isupper() else c for c in module)
    return quietly(lambda: fetch(f"{GO_PROXY}/{escaped}/@v/{sha}.info")["Version"], None)


def image_tags(owner, repo):
    """The tags of the public image ghcr.io/<owner>/<repo>, or [] where there is none."""
    def read():
        token = fetch(f"{GHCR}/token?scope=repository:{owner}/{repo}:pull&service=ghcr.io")["token"]
        # The registry pages a long list, and prune-images keeps each repository
        # far below this.
        return fetch(f"{GHCR}/v2/{owner}/{repo}/tags/list?n=1000",
                     {"Authorization": f"Bearer {token}"}).get("tags") or []
    return quietly(read, [])


def npm_versions(package):
    """Every version npmjs.com holds of package, or [] where it holds none."""
    return quietly(lambda: list(fetch(
        f"{NPM}/{package.replace('/', '%2f')}",
        {"Accept": "application/vnd.npm.install-v1+json"})["versions"]), [])


def published(versions, sha):
    """The version among versions that names commit sha, or None.

    A dev version ends with its commit: twelve characters after a hyphen in a Go
    pseudo-version, seven after a dot in a version an npm build stamps itself. A
    per-architecture image tag ends with its architecture instead, so it is never
    taken for a version."""
    hits = sorted(v for v in versions if v.endswith("-" + sha[:12]) or v.endswith("." + sha[:7]))
    return hits[-1] if hits else None


def parse_ts(ts):
    if not ts:
        return None
    return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)


def build(owner, name, token, window):
    meta = repo_meta(owner, name, token)
    branch = meta.get("default_branch") or "main"

    declared = declared_workflows(owner, name, token)
    runs = api(
        f"repos/{owner}/{name}/actions/runs?branch={branch}&per_page=100", token
    )["workflow_runs"]

    # Whether a commit is still on the branch. In the repository's own job a
    # checkout with its history answers, the branch's head being what it checked
    # out. Otherwise the branch's recent commits, asked for once, answer for
    # nearly every commit, and one older than those is compared against the
    # branch.
    #
    # A lookup that fails for any reason but the commit's being unknown stops the
    # file rather than passing a build over: a `built` that silently lost its
    # newest entry would move a sibling's pin back.
    local = own_run(owner, name) and local_history()
    branch_shas = None

    def on_branch(sha):
        nonlocal branch_shas
        if local:
            return subprocess.run(["git", "-C", workspace(), "merge-base", "--is-ancestor", sha, "HEAD"],
                                  capture_output=True).returncode == 0
        if branch_shas is None:
            branch_shas = {c.get("sha") for c in api(f"repos/{owner}/{name}/commits?sha={branch}&per_page=100", token)}
        if sha in branch_shas:
            return True
        # The branch is ahead of the commit, or is the commit: either way it holds it.
        try:
            cmp = api(f"repos/{owner}/{name}/compare/{sha}...{branch}", token)
        except urllib.error.HTTPError as exc:
            if exc.code in (404, 422):
                exc.close()   # it holds the response, and a refusal is all it says
                return False
            raise
        return cmp.get("status") in ("ahead", "identical")

    # A commit's images are out once every image repository the project
    # publishes to holds its version, read from the tag lists fetched below,
    # with no call to GitHub. The version tag goes last in each: an npm
    # package's wrapper after its platform packages, and a sandbox version's
    # list only once both architectures are in. A registry that does not answer
    # lists no repository, and names no build.
    def images_published(sha):
        return bool(images) and all(published(tags, sha) for tags in images.values())

    # The gate's passing push runs, from the history read above. Every other
    # workflow's runs share that page, and a long enough stretch of pushes that
    # change only the ledger can push every one of the gate's out of it. Only
    # then are the gate's own runs asked for.
    gate_runs = [r for r in runs if r.get("name") == GATE]
    if GATE in declared and not any(r.get("event") == "push" and r.get("conclusion") in PASSED for r in gate_runs):
        gate_file = os.path.basename(declared[GATE].get("path") or "") or "ci.yml"
        gate_runs = api(f"repos/{owner}/{name}/actions/workflows/{gate_file}/runs"
                        f"?branch={branch}&event=push&status=success&per_page=100", token)["workflow_runs"]

    # The versions each commit was published under. The places are named after
    # the project, as each publishes them: its Go module, its npm package
    # @<owner>/<name>, and its images, ghcr.io/<owner>/npm/<name> for the npm
    # package and <name> and <name>-slim for an image of its own. One that does
    # not exist answers nothing.
    module = module_path(owner, name, branch, token)
    images = {repo: image_tags(owner, repo) for repo in (f"npm/{name}", name, f"{name}-slim")}
    images = {repo: tags for repo, tags in images.items() if tags}
    packages = {f"@{owner}/{name}": npm_versions(f"@{owner}/{name}")}
    go = {}

    def versions(sha):
        return {
            "go": go.get(sha),
            "images": {repo: v for repo, tags in images.items() if (v := published(tags, sha))},
            "npm": {pkg: v for pkg, vs in packages.items() if (v := published(vs, sha))},
        }

    seen = {}
    for r in runs:
        wf = r.get("name") or "(unnamed)"
        if wf in SKIP_WORKFLOWS:
            continue
        if SKIP_RUN_ID and str(r.get("id")) == SKIP_RUN_ID:
            continue
        started, ended = parse_ts(r.get("run_started_at")), parse_ts(r.get("updated_at"))
        seen.setdefault(wf, []).append({
            "state": r.get("conclusion") or r.get("status") or "queued",
            "started": r.get("run_started_at"),
            "duration": int((ended - started).total_seconds()) if started and ended else None,
            "title": r.get("display_title") or "",
            "sha": (r.get("head_sha") or "")[:7],
            "event": r.get("event") or "",
            "attempt": r.get("run_attempt") or 1,
            "actor": (r.get("actor") or {}).get("login") or "",
            "url": r.get("html_url") or "",
            "commit": r.get("head_sha") or "",
        })

    workflows = []
    for wf in sorted(set(declared) | set(seen)):
        entries = sorted(seen.get(wf, []), key=lambda e: e["started"] or "", reverse=True)
        recent = entries[:window]
        verdicts = [e for e in recent if e["state"] in PASSED | FAILED]
        passes = [e for e in verdicts if e["state"] in PASSED]
        durations = [e["duration"] for e in verdicts if e["duration"] is not None]
        streak = 0
        for e in verdicts:
            if e["state"] not in PASSED:
                break
            streak += 1
        workflows.append({
            "name": wf,
            "path": (declared.get(wf) or {}).get("path", ""),
            "declared": wf in declared,
            "latest": entries[0] if entries else None,
            "runs": recent,
            "counted": len(verdicts),
            "pass_rate": round(100 * len(passes) / len(verdicts)) if verdicts else None,
            "failures": len(verdicts) - len(passes),
            "median_duration": int(statistics.median(durations)) if durations else None,
            "last_failure": next((e for e in entries if e["state"] in FAILED), None),
            "green_streak": streak,
        })

    # The primary gate leads; the rest follow alphabetically.
    workflows.sort(key=lambda w: (w["name"].lower() != "ci", w["name"].lower()))

    # The versions of the runs the file keeps, and of the built commit. The proxy
    # takes ten seconds or more over a commit it has not been asked about before,
    # and then remembers it, so the questions go out together rather than in turn.
    shas = built(gate_runs, on_branch, imaged=images_published if IMAGES in declared else None)
    kept = [e for w in workflows for e in (*w["runs"], w["latest"], w["last_failure"]) if e]
    commits = sorted({e["commit"] for e in kept if e["commit"]} | set(shas))
    if module and commits:
        with ThreadPoolExecutor(max_workers=16) as pool:
            go.update(zip(commits, pool.map(lambda c: go_version(module, c), commits)))
    for e in kept:
        e["versions"] = versions(e["commit"]) if e["commit"] else {"go": None, "images": {}, "npm": {}}
    return {
        "schema": SCHEMA,
        "generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "window": window,
        "repo": {
            "name": name,
            "full_name": f"{owner}/{name}",
            "description": meta.get("description") or "",
            "url": meta.get("html_url") or "",
            "branch": branch,
            "pushed_at": meta.get("pushed_at"),
        },
        "built": [built_entry(sha, versions) for sha in shas],
        "workflows": workflows,
    }


def main():
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if not token:
        sys.exit("ci-status: set GH_TOKEN or GITHUB_TOKEN")

    slug = os.environ.get("GITHUB_REPOSITORY", "")
    if len(sys.argv) > 1:
        slug = sys.argv[1]
    if "/" not in slug:
        sys.exit("ci-status: pass owner/repo, or run where GITHUB_REPOSITORY is set")
    owner, _, name = slug.partition("/")

    window = int(os.environ.get("CI_STATUS_WINDOW", "20"))
    out = os.environ.get("CI_STATUS_OUTPUT", "ci-status.json")

    try:
        data = build(owner, name, token, window)
    except urllib.error.HTTPError as exc:
        limited = " (rate limited)" if exc.headers.get("X-RateLimit-Remaining") == "0" else ""
        exc.close()
        sys.exit(f"ci-status: {slug}: HTTP {exc.code} {exc.reason}{limited}")
    except (urllib.error.URLError, OSError) as exc:
        sys.exit(f"ci-status: {slug}: {exc}")

    text = json.dumps(data, indent=1, sort_keys=False) + "\n"
    if out == "-":
        sys.stdout.write(text)
    else:
        with open(out, "w") as fh:
            fh.write(text)
        print(out)


if __name__ == "__main__":
    main()
